# ---- GitLab ----
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# How long GitLab data is cached, in seconds.
CACHE_TTL_SECONDS=30

# ---- Panel login ----
# username:hash pairs, comma-separated. Keep the single quotes: the hash contains "$".
# Generate a hash with: docker compose run --rm --no-deps --entrypoint /app/hashpassword backend 'your-password'
AUTH_USERS='admin:$2a$10$examplehashexamplehashexamplehashexamplehashexampleha'
SESSION_TTL_HOURS=24
# Set to true once the panel is served over HTTPS.
COOKIE_SECURE=false

# ---- Saved server passwords ----
# Encrypts saved SSH passwords. Never change it after setup.
# Generate with: docker compose run --rm --no-deps --entrypoint /app/genkey backend
CREDENTIAL_ENCRYPTION_KEY=

# ---- Docker Compose only ----
# Database credentials and the panel's port. DATABASE_URL is set automatically.
POSTGRES_USER=devops
POSTGRES_PASSWORD=devops
POSTGRES_DB=devops_wrapper
WEB_PORT=3000

# ---- Running without Docker only ----
PORT=8080
DATABASE_URL=postgres://devops:devops@localhost:5432/devops_wrapper
