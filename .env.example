PORT=8080
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
CACHE_TTL_SECONDS=30

# Generate hashes with: go run ./cmd/hashpassword <password>
AUTH_USERS=admin:$2a$10$examplehashexamplehashexamplehashexamplehashexampleha
SESSION_TTL_HOURS=24
# Set to true once served over HTTPS (e.g. behind a reverse proxy in production).
COOKIE_SECURE=false

# Postgres connection string. Services and sessions are persisted here.
DATABASE_URL=postgres://devops:devops@localhost:5432/devops_wrapper

# Encrypts saved SSH passwords at rest. Generate with: go run ./cmd/genkey
CREDENTIAL_ENCRYPTION_KEY=
